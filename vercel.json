{
  "crons": [
    {
      "path": "/api/cron/cart-abandonment",
      "schedule": "0 */4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/feed",
      "destination": "/api/feeds/google-shopping"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/feeds/google-shopping"
    }
  ],
  "headers": [
    {
      "source": "/product-feed.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/feed",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "trailingSlash": false
}
